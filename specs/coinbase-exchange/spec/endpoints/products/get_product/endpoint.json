{
  "docs": "https://docs.cdp.coinbase.com/exchange/reference/exchangerestapi_getproduct",
  "meta": {
    "public": true
  },
  "spec": {
    "kind": "rpc",
    "transports": [
      "http"
    ],
    "path": "/products/{product_id}",
    "method": "GET",
    "description": "One product, and the increments an order on it has to respect.",
    "request": {
      "title": "GetProductRequest",
      "type": "object",
      "description": "Which product.",
      "properties": {
        "product_id": {
          "type": "string",
          "description": "Product id, such as `BTC-USD`. `products.list_products` returns it as `id`."
        }
      },
      "required": [
        "product_id"
      ]
    },
    "response": {
      "$ref": "Product",
      "description": "The product."
    }
  }
}
